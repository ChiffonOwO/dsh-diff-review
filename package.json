{
  "name": "dsh-diff-review",
  "version": "0.1.0",
  "description": "Codex-style change review for DeepSeek Harness: a hover popover above the composer counts the files this turn changed, and a right-sidebar page shows each one's syntax-highlighted diff with a one-click revert.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "ChiffonOwO",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diff",
    "review",
    "changes",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChiffonOwO/dsh-diff-review.git"
  },
  "bugs": {
    "url": "https://github.com/ChiffonOwO/dsh-diff-review/issues"
  },
  "homepage": "https://github.com/ChiffonOwO/dsh-diff-review#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-connection": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.3.0",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs"
  }
}
